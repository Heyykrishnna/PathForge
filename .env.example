NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pathforge_dev
LOG_LEVEL=info
JWT_ACCESS_SECRET=dev_super_secret_jwt_access_key_min_32_chars_pathforge
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_super_secret_jwt_refresh_key_min_32_chars_pathforge
COOKIE_SECRET=dev_cookie_signing_secret_min_32_chars_pathforge
COOKIE_SECURE=false
REFRESH_TOKEN_EXPIRES_DAYS=7
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/github/callback

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
